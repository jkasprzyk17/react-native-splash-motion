{
  "name": "react-native-splash-motion",
  "version": "0.1.2",
  "description": "Animated Lottie splash screens for React Native — rendered natively before your JS loads. Zero native code. Built on Nitro.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-splash-motion-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-splash-motion-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && tsc -p tsconfig.cli.json",
    "nitrogen": "nitrogen",
    "typecheck": "tsc && tsc -p tsconfig.cli.json --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "example:splash": "tsc -p tsconfig.cli.json && node lib/cli/index.js generate assets/splash.json --project-root example --background \"#FFFFFF\" --width 200"
  },
  "keywords": [
    "react-native",
    "expo",
    "splash",
    "splash-screen",
    "bootsplash",
    "launch-screen",
    "lottie",
    "animation",
    "nitro",
    "new-architecture",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seyedmostafahasani/react-native-splash-motion.git"
  },
  "author": "MostafaHasani <seyedmostafahassani@gmail.com> (https://github.com/seyedmostafahasani)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seyedmostafahasani/react-native-splash-motion/issues"
  },
  "homepage": "https://github.com/seyedmostafahasani/react-native-splash-motion#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "nitrogen": "^0.37.1",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "^0.37.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.1"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "bin": {
    "splash-motion": "./lib/cli/index.js"
  }
}
