require "json"

package = JSON.parse(File.read(File.join(__dir__, "package.json")))

# Pick the renderer from the config generated by `npx splash-motion generate`,
# so apps only ship the runtime they actually use (Lottie OR Rive).
def splashmotion_renderer
  return ENV["SPLASHMOTION_RENDERER"] if ENV["SPLASHMOTION_RENDERER"]
  root = Pod::Config.instance.installation_root.to_s
  config = Dir.glob(File.join(root, "*", "*.xcassets", "SplashMotionConfig.dataset", "*.json")).first
  return "lottie" unless config
  JSON.parse(File.read(config))["type"] || "lottie"
rescue StandardError
  "lottie"
end

Pod::Spec.new do |s|
  s.name         = "RNSplashMotion"
  s.version      = package["version"]
  s.summary      = package["description"]
  s.homepage     = package["homepage"]
  s.license      = package["license"]
  s.authors      = package["author"]

  s.platforms    = { :ios => min_ios_version_supported }
  s.source       = { :git => "https://github.com/seyedmostafahasani/react-native-splash-motion.git", :tag => "v#{s.version}" }

  s.source_files = [
    "ios/**/*.{swift}",
    "ios/**/*.{m,mm}",
    "cpp/**/*.{hpp,cpp}",
  ]

  s.dependency 'React-jsi'
  s.dependency 'React-callinvoker'

  if splashmotion_renderer == "rive"
    s.dependency 'RiveRuntime', '~> 6.20'
  else
    s.dependency 'lottie-ios', '~> 4.5'
  end

  load 'nitrogen/generated/ios/RNSplashMotion+autolinking.rb'
  add_nitrogen_files(s)

  install_modules_dependencies(s)
end
